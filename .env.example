# Leave both blank to run entirely against the built-in mock catalog
# (src/data/mockData.js). Once Dizi Cashier support gives you the
# real API base URL and an API key/token, fill these in and copy
# this file to .env.local — the app will automatically switch from
# mock data to live requests (see src/lib/api.js).

VITE_API_BASE_URL=
VITE_API_KEY=
